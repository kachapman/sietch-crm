# Mail Scanner Configuration
# Copy this file to scanner/.env and fill in the values.

# IMAP account credentials
SCANNER_IMAP_HOST=imap.example.com
SCANNER_IMAP_PORT=993
SCANNER_IMAP_USER=scanner@example.com
SCANNER_IMAP_PASSWORD=change_me_in_production
SCANNER_INBOX=INBOX

# Polling interval in seconds
SCANNER_POLL_INTERVAL=300

# Enable/disable the scanner
SCANNER_ENABLED=false

# Action toggles (all false by default = dry-run, no actions taken)
SCANNER_CREATE_DEALS=false
SCANNER_CREATE_TASKS=false
SCANNER_POST_NOTES=false
SCANNER_NOTIFY_USERS=false

# Scanner admin token (for /api/v2/mail/* admin endpoints)
SCANNER_ADMIN_TOKEN=

# URL of the scanner service (used when scanner runs in a separate container).
# If empty, the scanner runs in-process within the dashboard server.
SCANNER_SERVICE_URL=