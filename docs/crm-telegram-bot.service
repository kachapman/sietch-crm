[Unit]
Description=Sietch CRM Telegram Bot (@SietchCRM_bot)
Documentation=https://github.com/kachapman/new-crm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/chapman-server/Projects/new-crm
ExecStart=/home/chapman-server/Projects/new-crm/.venv/bin/python3 /home/chapman-server/Projects/new-crm/telegram_bot.py
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=process
User=chapman-server

[Install]
WantedBy=multi-user.target
