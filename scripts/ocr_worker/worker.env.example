# Sietch OCR worker — example environment (NO SECRETS IN GIT)
#
# Copy to a private location and chmod 600:
#   mkdir -p ~/.config/sietch-ocr
#   cp worker.env.example ~/.config/sietch-ocr/worker.env
#   chmod 600 ~/.config/sietch-ocr/worker.env
#   $EDITOR ~/.config/sietch-ocr/worker.env
#
# Nothing in the program defaults to a hostname, username or machine id.
# These are EXAMPLES, not defaults. The same file moves with the worker.

# Required: CRM base URL (no trailing slash) and a token restricted to the
# "ocr" resource (Admin → API & MCP; methods GET+POST, resource ocr ONLY).
SIETCH_URL=https://crm.example.com
SIETCH_OCR_TOKEN=sietch_replace_me

# Optional: temp/work directory. /dev/shm keeps downloads off the SSD, but
# size it for the largest carrier PDF (a 50 MB scan can expand to several
# hundred MB of page images). Fall back to the system temp dir when unset.
# SIETCH_OCR_TMPDIR=/dev/shm

# Optional: Paddle device. Generic fallback is gpu:0; use "cpu" to test
# without a GPU (much slower).
# SIETCH_OCR_DEVICE=gpu:0

# Optional: PDF render DPI (100-400, default 200).
# SIETCH_OCR_DPI=200

# Optional: poll interval in seconds when the queue is empty (default 15).
# SIETCH_OCR_POLL_SECONDS=15

# Optional: cgroup limits applied by run.sh (generic fallbacks shown).
# SIETCH_OCR_MEMORY_MAX=12G
# SIETCH_OCR_MEMORY_SWAP_MAX=0
